#!/bin/bash
# runswmm6 - run the Kotlin SWMM6 engine: runswmm6 <input.inp> <report.rpt> [output.out]
# As the Java port's launcher: a 3 GB heap holds the biggest models; the engine runs on a thread with a 256 MB stack
# (src/main/Main.kt); the serial collector keeps a run to one core. -XX:-DontCompileHugeMethods lets HotSpot compile
# methods over 8,000 bytes of bytecode, which Kotlin's translations of the larger glibc routines and engine methods
# are (it changes what is compiled, not what is computed). JAVA_TOOL_OPTIONS (set in this environment for a network
# proxy the engine does not use) is dropped so that the JVM does not announce it on stderr, which the gate reads.
# SWMM6_KT_OPTS adds JVM options. Written by Claude (Anthropic) for Robert Dickinson's SWMM6 ports; see README.md.
D="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
unset JAVA_TOOL_OPTIONS
exec java -Xmx3g -XX:+UseSerialGC -XX:-UsePerfData -XX:-DontCompileHugeMethods $SWMM6_KT_OPTS -jar "$D/bin/openswmm.jar" "$@"
